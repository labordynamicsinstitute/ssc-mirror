f ../e/estat_loadings.ado
f ../e/estat_q2.ado
f ../e/estat_reliability.ado
f ../e/estat_summarize.ado
f ../e/estat_vif.ado
f ../e/estat_weights.ado
f ../o/output_plssem2.do
f ../t/test_plssem2.do
