*! xtfaclm 1.0.0  23jul2026
*! Factor-augmented panel LM unit-root test with two structural breaks
*! Payne-Lee-Islam-Nazlioglu greenhouse-gas convergence test (PANIC + LM breaks)
*! Author: Dr Merwan Roudane  (merwanroudane920@gmail.com)
*! https://github.com/merwanroudane
program xtfaclm, rclass
    version 14.0
    syntax varname [if] [in] , [ Model(string) Kmax(integer 5) ///
        ICfactor(integer 2) Pmax(integer 5) IClag(integer 2) ///
        Trim(real 0.3) Factors(integer -1) ]

    if ("`model'"=="") local model "constant"
    local model = strlower("`model'")
    if !inlist("`model'","constant","trend") {
        di as error "model() must be constant (level breaks) or trend (level & trend breaks)"
        exit 198
    }
    local mnum = cond("`model'"=="constant",1,2)
    if `iclag'<1 | `iclag'>3 {
        di as error "iclag() must be 1 (AIC), 2 (BIC) or 3 (t-stat)"
        exit 198
    }

    _xt, treq
    local id "`r(ivar)'"
    local tv "`r(tvar)'"
    marksample touse
    markout `touse' `varlist'
    qui xtset
    if "`r(balanced)'"!="strongly balanced" {
        di as error "xtfaclm requires a strongly balanced panel"
        exit 451
    }
    tempvar tag
    qui by `id': gen byte `tag' = _n==1 if `touse'
    qui count if `tag'
    local N = r(N)
    qui count if `touse'
    local T = r(N)/`N'
    if `T'*`N' != r(N) {
        di as error "panel is not balanced over the estimation sample"
        exit 451
    }
    qui su `tv' if `touse', meanonly
    local tmin = r(min)

    tempname OUT STAT
    mata: _xfl_run("`varlist'","`touse'", `N', `T', `mnum', `kmax', ///
        `icfactor', `pmax', `iclag', `trim', `factors', `tmin', "`OUT'", "`STAT'")

    // ---- display -----------------------------------------------------
    local mlab = cond(`mnum'==1,"level breaks","level & trend breaks")
    di ""
    di as txt "Factor-augmented panel LM unit-root test (two breaks)" ///
        _col(64) "N = " as res %4.0f `N'
    di as txt "H0: unit root (all panels)" _col(64) "T = " as res %4.0f `T'
    di as txt "Deterministics: `mlab'" _col(50) "Common factors = " as res %2.0f `STAT'[1,3]
    di as txt "{hline 66}"
    di as txt "  id" _col(11) "LM" _col(23) "p-value" _col(36) "break1" _col(48) "break2" _col(60) "lag"
    di as txt "{hline 66}"
    forvalues i = 1/`N' {
        di as res %4.0f `OUT'[`i',1] _col(7) %9.3f `OUT'[`i',2] ///
            _col(21) %8.3f `OUT'[`i',3] _col(34) %6.0f `OUT'[`i',4] ///
            _col(46) %6.0f `OUT'[`i',5] _col(59) %4.0f `OUT'[`i',6]
    }
    di as txt "{hline 66}"
    di as txt "Panel Fisher P (chi2, " as res %3.0f 2*`N' as txt " df)" ///
        _col(40) as res %9.3f `STAT'[1,1] as txt "   p = " as res %6.3f `STAT'[1,4]
    di as txt "Pm (standardized)" _col(40) as res %9.3f `STAT'[1,2] ///
        as txt "   p = " as res %6.3f `STAT'[1,5]
    di as txt "{hline 66}"
    di as txt "Reject H0 (=> stationary) for a large negative LM / large P/Pm."

    // ---- returns -----------------------------------------------------
    return scalar P    = `STAT'[1,1]
    return scalar Pm   = `STAT'[1,2]
    return scalar P_p  = `STAT'[1,4]
    return scalar Pm_p = `STAT'[1,5]
    return scalar nf   = `STAT'[1,3]
    return matrix units = `OUT'
    return local model  "`model'"
    return local cmd    "xtfaclm"
    return scalar N = `N'
    return scalar T = `T'
end

version 14.0
mata:

real colvector _xfl_lagn(real colvector x, real scalar n)
{
    real scalar r
    r = rows(x)
    if (n > 0) return((J(n,1,0) \ x[1..r-n]))
    if (n < 0) return((x[(1-n)..r] \ J(-n,1,0)))
    return(x)
}
real matrix _xfl_lagnM(real matrix x, real scalar n)
{
    real scalar r
    r = rows(x)
    if (n > 0) return((J(n,cols(x),0) \ x[1..r-n,.]))
    return(x)
}
real colvector _xfl_diff(real colvector x)
{
    real scalar r
    r = rows(x)
    return((0 \ (x[2..r]-x[1..r-1])))
}
real matrix _xfl_diffM(real matrix x)
{
    real scalar r
    r = rows(x)
    return((J(1,cols(x),0) \ (x[2..r,.]-x[1..r-1,.])))
}
void _xfl_ols(real colvector y, real matrix X, real colvector b,
    real colvector e, real scalar sig2, real colvector se, real scalar ssr)
{
    real matrix m
    m = invsym(cross(X,X))
    b = m*cross(X,y)
    e = y - X*b
    ssr = cross(e,e)
    sig2 = ssr/(rows(y)-cols(X))
    se = sqrt(diagonal(m)*sig2)
}
real scalar _xfl_argmin(real colvector v)
{
    real scalar i, im, mn
    mn = v[1]; im = 1; i = 2
    while (i <= rows(v)) {
        if (v[i] < mn) {
            mn = v[i]; im = i
        }
        i = i + 1
    }
    return(im)
}
real matrix _xfl_z2breaks(real scalar model, real scalar t, real scalar tb1, real scalar tb2)
{
    real colvector dt, du1, du2, dt1, dt2
    dt = (1::t)
    du1 = (J(tb1,1,0) \ J(t-tb1,1,1))
    du2 = (J(tb2,1,0) \ J(t-tb2,1,1))
    if (model==1) return((dt, du1, du2))
    dt1 = (J(tb1,1,0) \ (1::(t-tb1)))
    dt2 = (J(tb2,1,0) \ (1::(t-tb2)))
    return((dt, du1, dt1, du2, dt2))
}
real scalar _xfl_getlag(real scalar ic, real scalar pmax,
    real colvector aicp, real colvector sicp, real colvector tstatp)
{
    real scalar p, j
    if (ic==1) return(_xfl_argmin(aicp))
    if (ic==2) return(_xfl_argmin(sicp))
    j = pmax + 1
    p = 1
    while (j >= 1) {
        if (abs(tstatp[j]) > 1.645 | j==1) {
            p = j; j = 0
        }
        else j = j - 1
    }
    return(p)
}
// PCA (Bai-Ng) returning Fhat (T x nf), lambda (n x nf), residual SS-based ehat
void _xfl_pca(real matrix X, real scalar nf, real matrix Fhat, real matrix lambda, real matrix ehat)
{
    real matrix vecs
    real colvector vals, idx
    real scalar t, n
    t = rows(X); n = cols(X)
    if (t < n) {
        symeigensystem(cross(X',X'), vecs, vals)
        idx = _xfl_topidx(vals', nf)
        Fhat = sqrt(t)*vecs[.,idx]
        lambda = cross(X, Fhat)/t
    }
    else {
        symeigensystem(cross(X,X), vecs, vals)
        idx = _xfl_topidx(vals', nf)
        lambda = sqrt(n)*vecs[.,idx]
        Fhat = X*lambda/n
    }
    ehat = X - Fhat*lambda'
}
real colvector _xfl_topidx(real colvector vals, real scalar nf)
{
    real colvector o, top
    o = order(vals, -1)          // descending eigenvalue order
    top = o[1..nf]
    return(top[(nf::1)])         // reverse => ascending among top nf (last = largest), matching GAUSS eighv
}
// Bai-Ng (2002) number of factors; returns ICp2 minimizer (0..kmax)
real scalar _xfl_fnumber(real matrix X, real scalar kmax, real scalar ic)
{
    real matrix Fhat, lambda, ehat
    real colvector V, IC2
    real scalar t, n, sigma2, k, cmin, pen
    t = rows(X); n = cols(X)
    _xfl_pca(X, kmax, Fhat, lambda, ehat)
    sigma2 = sum(ehat:^2)/(n*t)
    V = J(kmax,1,0)
    IC2 = J(kmax+1,1,0)
    cmin = min((n,t))
    k = 1
    while (k <= kmax) {
        _xfl_pca(X, k, Fhat, lambda, ehat)
        V[k] = sum(ehat:^2)/(n*t)
        if (ic==1)      pen = k*sigma2*(n+t)/(n*t)*ln(cmin)
        else if (ic==2) pen = k*(n+t)/(n*t)*ln(cmin)
        else if (ic==3) pen = k*sigma2*(2/n)
        else            pen = k*sigma2*(ln(n)/n)
        if (ic==2) IC2[k+1] = ln(V[k]) + pen
        else       IC2[k+1] = V[k] + pen
        k = k + 1
    }
    // k = 0 term
    if (ic==2) IC2[1] = ln(sum((X:-mean(X)):^2)/(n*t))
    else       IC2[1] = sum((X:-mean(X)):^2)/(n*t)
    return(_xfl_argmin(IC2) - 1)
}
// break search on one differenced series (min SSR), returns tb1,tb2 + residual + fitted
void _xfl_resid_iter1(real colvector dy, real scalar model, real scalar Tf,
    real scalar trim, real scalar tb1o, real scalar tb2o, real colvector resid, real colvector dyh)
{
    real scalar T1, T2, tb1, tb2, ssr, ssrmin, gap
    real matrix z, dz
    real colvector b, w
    T1 = round(trim*Tf)
    T2 = round((1-trim)*Tf)
    ssrmin = 1e18
    tb1o = 0; tb2o = 0
    if (model==1) gap = 2
    else gap = 3
    tb1 = T1
    while (tb1 <= T2) {
        tb2 = tb1 + gap
        while (tb2 <= T2) {
            z = _xfl_z2breaks(model, Tf, tb1, tb2)
            dz = _xfl_diffM(z)[2..rows(z),.]
            b = invsym(cross(dz,dz))*cross(dz,dy)
            w = dy - dz*b
            ssr = cross(w,w)
            if (ssr < ssrmin) {
                ssrmin = ssr
                tb1o = tb1; tb2o = tb2
                resid = w
                dyh = dz*b
            }
            tb2 = tb2 + 1
        }
        tb1 = tb1 + 1
    }
}
// factor-augmented 2-break LM statistic for one series; returns (LM, lag)
real rowvector _xfl_lm2br(real colvector y, real colvector ww, real scalar tb1,
    real scalar tb2, real matrix Fhat, real scalar model, real scalar pmax, real scalar iclag)
{
    real scalar Tf, nobs, p, j, laglm, LM
    real colvector st, s2, ylm, dylm, dep, ls, dyf, taup, aicp, sicp, tstatp, b, e, se
    real scalar sig2, ssr
    real matrix z, dz, F, ds, lmat, x
    Tf = rows(y)
    st = runningsum(ww)
    z = _xfl_z2breaks(model, Tf, tb1, tb2)
    nobs = Tf - 1
    s2 = J(nobs,1,0)
    s2[1..tb1] = st[1..tb1] :/ (tb1/nobs)
    s2[(tb1+1)..tb2] = st[(tb1+1)..tb2] :/ ((tb2-tb1)/nobs)
    s2[(tb2+1)..nobs] = st[(tb2+1)..nobs] :/ ((nobs-tb2)/nobs)
    ylm = s2
    dylm = _xfl_diff(ylm)[2..rows(ylm)]
    lmat = J(rows(dylm), pmax, 0)
    j = 1
    while (j <= pmax) {
        lmat[.,j] = _xfl_lagn(dylm, j)
        j = j + 1
    }
    taup = J(pmax+1,1,0); aicp = J(pmax+1,1,0); sicp = J(pmax+1,1,0); tstatp = J(pmax+1,1,0)
    p = 0
    while (p <= pmax) {
        dep = _xfl_diff(y)[(p+3)..Tf]                          // trimr(diff(y), p+2, 0)
        ls  = _xfl_lagn(ylm,1)[(p+2)..rows(ylm)]               // trimr(lagn(ylm,1), p+1, 0)
        dz  = _xfl_diffM(z)[(p+3)..rows(z),.]                  // trimr(diff(z), p+2, 0)
        F   = Fhat[(p+2)..rows(Fhat),.]                        // trimr(Fhat, p+1, 0)
        ds  = lmat[(p+1)..rows(lmat),.]                        // trimr(lmat, p, 0)
        if (p==0) x = ls, dz, F
        else      x = ls, dz, ds[.,1..p], F
        _xfl_ols(dep, x, b, e, sig2, se, ssr)
        taup[p+1] = b[1]/se[1]
        aicp[p+1] = ln(cross(e,e)/rows(x)) + 2*(cols(x)+2)/rows(x)
        sicp[p+1] = ln(cross(e,e)/rows(x)) + (cols(x)+2)*ln(rows(x))/rows(x)
        tstatp[p+1] = abs(b[cols(x)]/se[cols(x)])
        p = p + 1
    }
    laglm = _xfl_getlag(iclag, pmax, aicp, sicp, tstatp)
    LM = taup[laglm]
    return((LM, laglm-1))
}
real colvector _xfl_pgrid()
{
    return((0.0001 \ 0.0002 \ 0.0005) \ ((1::9)/1000) \ (0.005:*(2::198)) \ ((991::999)/1000) \ (0.9995 \ 0.9998 \ 0.9999))
}
real scalar _xfl_pval(real scalar test, real scalar model, real scalar Targ, real scalar plags)
{
    real matrix params, Xw
    real colvector p, reg, cv, yv, bw, idx
    real scalar it, pt, mn, mx, bands, lower, lo, hi, pval
    if (model==1) params = _xfl_rs0()
    else          params = _xfl_rs2()
    it = 1/Targ
    pt = plags/Targ
    reg = (1 \ it \ it^2 \ pt \ pt^2)
    cv = params*reg
    p = _xfl_pgrid()
    mn = min(cv); mx = max(cv)
    if (test < mn) return(0.0001)
    if (test > mx) return(1)
    bands = 10
    idx = selectindex(cv :<= test)
    lower = max(idx)
    lo = lower - bands + 1
    hi = lower + bands
    if (lower < bands) {
        lo = 1
        hi = bands
    }
    if (lower > rows(cv)-bands) {
        lo = rows(cv) - bands - 1
        hi = rows(cv)
    }
    yv = invnormal(p[lo..hi])
    Xw = J(hi-lo+1,1,1) , cv[lo..hi] , cv[lo..hi]:^2 , cv[lo..hi]:^3
    bw = qrsolve(Xw, yv)
    pval = normal((1, test, test^2, test^3) * bw)
    if (pval > 1) pval = 1
    if (pval < 0) pval = 0.0001
    return(pval)
}

// ---------- driver ---------------------------------------------------
void _xfl_run(string scalar vname, string scalar touse, real scalar N,
    real scalar T, real scalar model, real scalar kmax, real scalar icfac,
    real scalar pmax, real scalar iclag, real scalar trim, real scalar forcenf,
    real scalar tmin, string scalar outname, string scalar statname)
{
    real matrix Y, dy, dy_iter, rr, dyh, Fhat, lambda, ehat, de, ww, out
    real colvector v, Ntb1, Ntb2, resid, dyhi, LMv, pv, lags
    real scalar i, nf, ssr1, ssr2, count, tb1, tb2, P, Pm, lag
    real rowvector lm
    v = st_data(., vname, touse)
    Y = colshape(v, T)'                 // T x N
    dy = _xfl_diffM(Y)[2..T,.]          // (T-1) x N
    dy_iter = dy
    Ntb1 = J(N,1,0); Ntb2 = J(N,1,0)
    rr = J(T-1, N, 0); dyh = J(T-1, N, 0)
    ssr1 = (vec(dy)'vec(dy))/(T*N)
    count = 0
    nf = 0
    while (count < 50) {
        count = count + 1
        for (i=1; i<=N; i++) {
            _xfl_resid_iter1(dy_iter[.,i], model, T, trim, tb1, tb2, resid, dyhi)
            rr[.,i] = resid
            dyh[.,i] = dyhi
            Ntb1[i] = tb1
            Ntb2[i] = tb2
        }
        if (forcenf >= 0) nf = forcenf
        else nf = _xfl_fnumber(rr, kmax, icfac)
        if (nf < 1) nf = 1
        _xfl_pca(rr, nf, Fhat, lambda, ehat)
        de = dy_iter - Fhat*lambda'
        ssr2 = (vec(de)'vec(de))/(T*N)
        if (abs(ssr1-ssr2) > 0.001) {
            ssr1 = ssr2
            dy_iter = dy - Fhat*lambda'
        }
        else count = 100
    }
    ww = dy - dyh - Fhat*lambda'
    LMv = J(N,1,0); pv = J(N,1,0); lags = J(N,1,0)
    for (i=1; i<=N; i++) {
        lm = _xfl_lm2br(Y[.,i], ww[.,i], Ntb1[i], Ntb2[i], Fhat, model, pmax, iclag)
        LMv[i] = lm[1]
        lag = lm[2]
        lags[i] = lag
        pv[i] = _xfl_pval(lm[1], model, T-lag, lag)
    }
    P  = -2*sum(ln(pv))
    Pm = (P - 2*N)/sqrt(4*N)
    out = (1::N), LMv, pv, (tmin :+ Ntb1 :- 1), (tmin :+ Ntb2 :- 1), lags
    st_matrix(outname, out)
    st_matrixcolstripe(outname, (J(6,1,""), ("id","LM","pval","break1","break2","lag")'))
    st_matrix(statname, (P, Pm, nf, chi2tail(2*N,P), 1-normal(Pm)))
}

